<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?ifndef ProductVersion?>
    <?define ProductVersion = "1.0.0.0"?>
  <?endif?>

  <Product Id="*"
           Name="OutaSpace"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="Brian Kiefer"
           UpgradeCode="5B04EBFA-0E54-4B2D-9B1D-4659D6F39F80">

    <Package InstallerVersion="300"
             Compressed="yes"
             InstallScope="perUser"
             InstallPrivileges="limited"
             Description="OutaSpace Disk Space Analyzer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="build/windows/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- Target: %LOCALAPPDATA%\Programs\OutaSpace -->
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="OutaSpace" />
        </Directory>
      </Directory>

      <!-- Per-User Start Menu Shortcuts: %APPDATA%\Microsoft\Windows\Start Menu\Programs -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="OutaSpace" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="3E4F63E2-5573-45AE-B647-384A950CE915">
        <File Id="OutaSpaceExe" Source="build/bin/OutaSpace.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="7B9CD7FA-F652-4467-93C0-1C712E3C0F52">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="OutaSpace"
                  Description="OutaSpace Disk Space Analyzer"
                  Target="[INSTALLFOLDER]OutaSpace.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\OutaSpace" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="OutaSpace" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Product>
</Wix>
